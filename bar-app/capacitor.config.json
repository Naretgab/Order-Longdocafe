{
  "appId": "th.longdocafe.bar",
  "appName": "Long Do Bar",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "กำลังค้นหาเครื่องพิมพ์…",
        "cancel": "ยกเลิก",
        "availableDevices": "อุปกรณ์ที่พบ",
        "noDeviceFound": "ไม่พบเครื่องพิมพ์"
      }
    }
  }
}
